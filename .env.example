# Required for Raspberry Pi mission control.
RASPI_HOST=<Raspberry Pi IP，例如 192.168.1.50>
RASPI_USER=<Raspberry Pi 帳號，例如 user>
RASPI_PSW=<Raspberry Pi 密碼>
RASPI_PORT=22

# Raspberry Pi uploads noise.csv to this computer when a mission stops.
# Use this computer's Wi-Fi/LAN IPv4 address. Do not use localhost, 127.0.0.1,
# or an address copied from another computer.
USRP_UPLOAD_API_URL=http://<這台電腦的區網 IPv4>:8888/api/usrp/upload-noise-csv

# Required for protected scene rename and delete operations.
SCENE_ADMIN_TOKEN=replace-with-a-long-random-token
