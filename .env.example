# Required for Raspberry Pi mission control.
RASPI_HOST=<Raspberry Pi IP，例如 192.168.1.50>
RASPI_USER=<Raspberry Pi 帳號，例如 user>
RASPI_PSW=<Raspberry Pi 密碼>
RASPI_PORT=22

# Raspberry Pi uploads noise.csv to this computer when a mission stops.
# Use this computer's Wi-Fi/LAN IPv4 address. Do not use localhost, 127.0.0.1,
# or an address copied from another computer.
USRP_UPLOAD_API_URL=http://<這台電腦的區網 IPv4>:8888/api/usrp/upload-noise-csv

# Optional: upload noise.csv to multiple backends after USRP capture stops.
# Keep USRP_UPLOAD_API_URL for old single-destination setups; when this is set,
# USRP_UPLOAD_API_URLS takes priority.
USRP_UPLOAD_API_URLS=http://<A laptop IPv4>:8888/api/usrp/upload-noise-csv,https://backend.simworld.website/api/usrp/upload-noise-csv

# Optional: when this computer is laptop A, stream each AP3/controller GPS point
# to laptop B in real time. Use laptop B's Wi-Fi/LAN IPv4 address.
GPS_SYNC_API_URL=http://<B laptop IPv4>:8888/api/usrp/sync-gps-point
GPS_SYNC_DEVICE_ID=align-m4p-top-aircraft
GPS_SYNC_DEVICE_NAME=M4P TOP Aircraft
GPS_SYNC_DEVICE_TYPE=uav

# Required for protected scene rename and delete operations.
SCENE_ADMIN_TOKEN=replace-with-a-long-random-token
