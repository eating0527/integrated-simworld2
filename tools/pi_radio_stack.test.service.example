[Unit]
Description=Start Raspberry Pi TEST RX mission stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user
Environment=MODE=test
Environment=WORKDIR=/home/user/rx_sampling
Environment=PYTHON_BIN=/usr/bin/python3
Environment=RX_SCRIPT=/home/user/rx_sampling/rx_no_gui_test.py
Environment=TX_SCRIPT=/home/user/rx_sampling/tx_no_gui.py
Environment=JAMMER_SCRIPT=/home/user/rx_sampling/jam_no_gui.py
Environment=START_TX=0
Environment=START_JAMMER=0
Environment=NOISE_CSV=/home/user/rx_sampling/noise.csv
EnvironmentFile=-/run/simworld/usrp.env
ExecStart=/bin/bash /home/user/pi_radio_stack.sh
KillMode=control-group
TimeoutStopSec=20s
Restart=no

[Install]
# Intentionally not enabled at boot. The backend starts this unit per mission.
