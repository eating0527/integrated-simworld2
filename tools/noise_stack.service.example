[Unit]
Description=GNU Radio noise source and CSV logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/digitaltwin-modulation/USRP_transmit/noise_detect
ExecStart=/bin/bash -lc 'xvfb-run -a /usr/bin/python3 /home/user/digitaltwin-modulation/USRP_transmit/noise_detect/noise.py & /usr/bin/python3 /home/user/zmq_to_noise_csv.py --noise-csv /home/user/digitaltwin-modulation/USRP_transmit/noise_detect/noise.csv'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
