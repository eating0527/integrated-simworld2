[Unit]
Description=Watch noise.csv and upload to laptop automatically
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user
ExecStart=/usr/bin/python3 /home/user/watch_and_upload_noise.py \
  --noise-csv /home/user/digitaltwin-modulation/USRP_transmit/noise_detect/noise.csv \
  --uploader-script /home/user/upload_noise_csv.py \
  --api-url http://192.168.50.95:8888/api/usrp/upload-noise-csv \
  --scene NTPU \
  --mission-id flight_001 \
  --auto-simulate-last
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
